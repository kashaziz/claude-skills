#!/bin/bash
# Auto-generated verification script for {{APP_NAME}}
# Generated by full-stack-mvp-builder skill

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
BACKEND_URL="http://localhost:{{BACKEND_PORT}}"
FRONTEND_URL="http://localhost:4321"
PASSED=0
FAILED=0

echo "🧪 Verifying {{APP_NAME}} installation..."
echo ""

# Function to check if a service is running
check_service() {
    local name=$1
    local url=$2
    local expected_status=${3:-200}

    echo -n "Checking $name... "

    response=$(curl -s -o /dev/null -w "%{http_code}" "$url" 2>/dev/null)

    if [ "$response" -eq "$expected_status" ]; then
        echo -e "${GREEN}✅ OK${NC} (HTTP $response)"
        ((PASSED++))
        return 0
    else
        echo -e "${RED}❌ FAIL${NC} (HTTP $response, expected $expected_status)"
        ((FAILED++))
        return 1
    fi
}

# Function to check if a port is listening
check_port() {
    local name=$1
    local port=$2

    echo -n "Checking $name (port $port)... "

    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then
        echo -e "${GREEN}✅ Listening${NC}"
        ((PASSED++))
        return 0
    else
        echo -e "${RED}❌ Not listening${NC}"
        echo -e "${YELLOW}   → Make sure the service is running${NC}"
        ((FAILED++))
        return 1
    fi
}

# Function to test API endpoint
test_api_endpoint() {
    local name=$1
    local method=$2
    local url=$3
    local data=$4
    local expected_status=${5:-200}

    echo -n "Testing $name... "

    if [ -n "$data" ]; then
        response=$(curl -s -o /dev/null -w "%{http_code}" -X "$method" \
            -H "Content-Type: application/json" \
            -d "$data" \
            "$url" 2>/dev/null)
    else
        response=$(curl -s -o /dev/null -w "%{http_code}" -X "$method" "$url" 2>/dev/null)
    fi

    if [ "$response" -eq "$expected_status" ]; then
        echo -e "${GREEN}✅ OK${NC} (HTTP $response)"
        ((PASSED++))
        return 0
    else
        echo -e "${RED}❌ FAIL${NC} (HTTP $response, expected $expected_status)"
        ((FAILED++))
        return 1
    fi
}

echo "=== Port Checks ==="
check_port "Backend" {{BACKEND_PORT}}
check_port "Frontend" 4321
{{#if_has_database}}
check_port "PostgreSQL" 5432
{{/if_has_database}}
echo ""

echo "=== Health Checks ==="
check_service "Backend Health" "$BACKEND_URL/health"
check_service "Frontend" "$FRONTEND_URL"
echo ""

echo "=== API Endpoint Tests ==="

# Test authentication endpoints
test_api_endpoint "Auth - Signup (should fail without data)" "POST" "$BACKEND_URL/api/auth/signup" "" 400
test_api_endpoint "Auth - Login (should fail with invalid credentials)" "POST" "$BACKEND_URL/api/auth/login" '{"email":"test@test.com","password":"wrong"}' 401

{{#if_has_cors}}
# Test CORS
echo -n "Testing CORS configuration... "
cors_headers=$(curl -s -I -H "Origin: http://localhost:4321" "$BACKEND_URL/api/health" | grep -i "access-control-allow-origin")
if [ -n "$cors_headers" ]; then
    echo -e "${GREEN}✅ OK${NC}"
    ((PASSED++))
else
    echo -e "${RED}❌ FAIL${NC} (CORS headers not found)"
    ((FAILED++))
fi
{{/if_has_cors}}

echo ""

echo "=== Database Connection ==="
{{#if_backend_express}}
echo -n "Testing Prisma connection... "
cd backend
if npx prisma db pull --schema=./prisma/schema.prisma >/dev/null 2>&1; then
    echo -e "${GREEN}✅ OK${NC}"
    ((PASSED++))
else
    echo -e "${RED}❌ FAIL${NC}"
    echo -e "${YELLOW}   → Check DATABASE_URL in backend/.env${NC}"
    ((FAILED++))
fi
cd ..
{{/if_backend_express}}

{{#if_backend_django}}
echo -n "Testing Django database connection... "
cd backend
if python manage.py check --database default >/dev/null 2>&1; then
    echo -e "${GREEN}✅ OK${NC}"
    ((PASSED++))
else
    echo -e "${RED}❌ FAIL${NC}"
    echo -e "${YELLOW}   → Check database settings in backend/config/settings.py${NC}"
    ((FAILED++))
fi
cd ..
{{/if_backend_django}}

{{#if_backend_fastapi}}
echo -n "Testing FastAPI database connection... "
cd backend
if python -c "from sqlalchemy import create_engine; from app.config import settings; engine = create_engine(settings.DATABASE_URL); engine.connect()" >/dev/null 2>&1; then
    echo -e "${GREEN}✅ OK${NC}"
    ((PASSED++))
else
    echo -e "${RED}❌ FAIL${NC}"
    echo -e "${YELLOW}   → Check DATABASE_URL in backend/.env${NC}"
    ((FAILED++))
fi
cd ..
{{/if_backend_fastapi}}

echo ""

# File structure checks
echo "=== File Structure ==="
echo -n "Checking required files... "

required_files=(
    "backend/.env"
    "backend/package.json"
    "frontend/package.json"
    "frontend/astro.config.mjs"
    "docker-compose.yml"
)

missing_files=0
for file in "${required_files[@]}"; do
    if [ ! -f "$file" ]; then
        if [ $missing_files -eq 0 ]; then
            echo ""
        fi
        echo -e "${RED}   ❌ Missing: $file${NC}"
        ((missing_files++))
        ((FAILED++))
    fi
done

if [ $missing_files -eq 0 ]; then
    echo -e "${GREEN}✅ OK${NC}"
    ((PASSED++))
fi

echo ""

# Summary
echo "=========================================="
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✅ All checks passed! ($PASSED/$((PASSED+FAILED)))${NC}"
    echo "=========================================="
    echo ""
    echo "Your app is ready to use! 🎉"
    echo ""
    echo "Next steps:"
    echo "1. Visit http://localhost:4321 to see your app"
    echo "2. Try creating an account and logging in"
    echo "3. Run the E2E tests: cd frontend && npm run test:e2e"
    echo ""
    exit 0
else
    echo -e "${RED}❌ Some checks failed ($PASSED passed, $FAILED failed)${NC}"
    echo "=========================================="
    echo ""
    echo "Troubleshooting:"
    echo ""
    echo "1. Make sure services are running:"
    echo "   - Backend: cd backend && npm run dev (or python manage.py runserver)"
    echo "   - Frontend: cd frontend && npm run dev"
    echo "   - Database: docker-compose up -d"
    echo ""
    echo "2. Check logs for errors:"
    echo "   - Backend logs in the terminal"
    echo "   - Database logs: docker-compose logs postgres"
    echo ""
    echo "3. Verify environment variables:"
    echo "   - backend/.env should have DATABASE_URL and JWT_SECRET"
    echo ""
    exit 1
fi
